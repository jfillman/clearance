{
  "version": "opclass/1",
  "classes": ["availability", "privilege", "data-integrity", "security-boundary", "credential-exposure"],
  "none": "none",
  "kinds": {
    "Secret": ["credential-exposure"],
    "ExternalSecret": ["credential-exposure"],
    "SealedSecret": ["credential-exposure"],
    "SecretStore": ["credential-exposure"],
    "ClusterSecretStore": ["credential-exposure"],
    "Role": ["privilege"],
    "ClusterRole": ["privilege"],
    "RoleBinding": ["privilege"],
    "ClusterRoleBinding": ["privilege"],
    "ServiceAccount": ["privilege"],
    "NetworkPolicy": ["security-boundary"],
    "Ingress": ["security-boundary", "availability"],
    "Gateway": ["security-boundary", "availability"],
    "HTTPRoute": ["security-boundary", "availability"],
    "Certificate": ["security-boundary"],
    "Issuer": ["security-boundary"],
    "ClusterIssuer": ["security-boundary"],
    "ValidatingWebhookConfiguration": ["security-boundary"],
    "MutatingWebhookConfiguration": ["security-boundary"],
    "ValidatingAdmissionPolicy": ["security-boundary"],
    "ValidatingAdmissionPolicyBinding": ["security-boundary"],
    "ValidatingPolicy": ["security-boundary"],
    "ClusterPolicy": ["security-boundary"],
    "PersistentVolumeClaim": ["data-integrity"],
    "PersistentVolume": ["data-integrity"],
    "StorageClass": ["data-integrity"],
    "VolumeSnapshot": ["data-integrity"],
    "VolumeSnapshotClass": ["data-integrity"],
    "StatefulSet": ["data-integrity", "availability"],
    "Cluster": ["data-integrity", "availability"],
    "Deployment": ["availability"],
    "Rollout": ["availability"],
    "DaemonSet": ["availability"],
    "ReplicaSet": ["availability"],
    "Service": ["availability"],
    "HorizontalPodAutoscaler": ["availability"],
    "PodDisruptionBudget": ["availability"],
    "Job": ["availability"],
    "CronJob": ["availability"]
  },
  "fields": [
    {"contains": "securityContext", "classes": ["privilege"]},
    {"contains": "serviceAccountName", "classes": ["privilege"]},
    {"contains": "hostNetwork", "classes": ["security-boundary"]},
    {"contains": "hostPID", "classes": ["security-boundary"]},
    {"contains": "secretKeyRef", "classes": ["credential-exposure"]},
    {"contains": "envFrom", "classes": ["credential-exposure"]},
    {"contains": "/volumeClaimTemplates", "classes": ["data-integrity"]},
    {"contains": "persistentVolumeClaim", "classes": ["data-integrity"]}
  ],
  "paths": [
    {"glob": "**/rbac/**", "classes": ["privilege"]},
    {"glob": "**/secrets/**", "classes": ["credential-exposure"]},
    {"glob": "**/network-policies/**", "classes": ["security-boundary"]},
    {"glob": "**/networkpolicies/**", "classes": ["security-boundary"]}
  ],
  "terraform": [
    {"types": ["aws_iam_*", "aws_ssoadmin_*", "aws_organizations_policy*", "aws_lambda_permission", "aws_s3_bucket_policy",
      "aws_sqs_queue_policy", "aws_sns_topic_policy", "aws_ecr_repository_policy", "google_*_iam_*", "google_service_account*",
      "google_organization_policy", "azurerm_role_assignment", "azurerm_role_definition", "azurerm_user_assigned_identity",
      "azuread_*", "kubernetes_*role*", "kubernetes_service_account*"], "classes": ["privilege"]},
    {"types": ["aws_secretsmanager_*", "aws_ssm_parameter", "aws_kms_*", "google_kms_*", "google_secret_manager_*",
      "azurerm_key_vault*", "random_password", "tls_private_key", "aws_iam_access_key", "aws_iam_user_login_profile"],
      "classes": ["credential-exposure"]},
    {"types": ["aws_security_group", "aws_security_group_rule", "aws_default_security_group", "aws_vpc_security_group_*",
      "aws_network_acl", "aws_network_acl_*", "aws_default_network_acl", "google_compute_firewall*",
      "azurerm_network_security_group", "azurerm_network_security_rule", "aws_wafv2_*", "aws_s3_bucket_public_access_block"],
      "classes": ["security-boundary"]},
    {"types": ["aws_db_*", "aws_rds_*", "aws_dynamodb_*", "aws_docdb_*", "aws_neptune_*", "aws_redshift_*", "aws_elasticache_*",
      "aws_memorydb_*", "aws_dax_*", "aws_keyspaces_*", "aws_timestreamwrite_*", "aws_s3_bucket", "aws_s3_bucket_versioning",
      "aws_s3_bucket_lifecycle_configuration", "aws_ebs_volume", "aws_efs_*", "aws_backup_*", "google_sql_*", "google_spanner_*",
      "google_bigtable_*", "google_firestore_*", "google_alloydb_*", "google_storage_bucket", "azurerm_*sql*", "azurerm_cosmosdb_*",
      "azurerm_redis_*", "azurerm_storage_*"], "classes": ["data-integrity"]},
    {"types": ["aws_instance", "aws_autoscaling_*", "aws_lb", "aws_lb_*", "aws_alb*", "aws_elb*", "aws_ecs_*", "aws_eks_*",
      "aws_lambda_function", "aws_lambda_alias", "aws_route53_*", "aws_vpc", "aws_subnet", "aws_route_table*", "aws_route",
      "aws_internet_gateway", "aws_nat_gateway", "aws_cloudfront_*", "google_compute_*", "google_container_*",
      "azurerm_kubernetes_*", "azurerm_virtual_machine*", "kubernetes_deployment*", "kubernetes_stateful_set*",
      "kubernetes_daemon_set*", "kubernetes_service"], "classes": ["availability"]}
  ],
  "fallback": ["availability"]
}
