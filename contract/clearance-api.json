{
  "api": "clearance-api",
  "version": "v1",
  "notes": "GET only. clearance-api reads what the Clearance core committed. Writes go to the core (POST /v1/clearances/{id}/clear and /deny, /v1/provenance, /v1/records); the runtime's reads and writes (sessions, tasks, agents and their holds, the human inbox, events, results, runtimes) are the AI gateway's.",
  "operations": [
    {
      "operationId": "listEvidence",
      "method": "GET",
      "path": "/v1/evidence",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "task",
        "session",
        "agent",
        "tool",
        "principal",
        "decision",
        "rule",
        "app",
        "since",
        "until",
        "limit",
        "after",
        "outcomes"
      ],
      "summary": "Evidence records you may see, newest first; the cursor is seq. outcomes=include (default), exclude or only: the outcome records the core writes beside each allowed decision (outcome_of)"
    },
    {
      "operationId": "getEvidence",
      "method": "GET",
      "path": "/v1/evidence/{seq}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "One evidence record with its hash"
    },
    {
      "operationId": "verifyEvidence",
      "method": "GET",
      "path": "/v1/evidence/verify",
      "roles": [
        "auditor"
      ],
      "params": [],
      "summary": "The whole chain checked from genesis: ok, count, head, the first bad seq"
    },
    {
      "operationId": "countEvidence",
      "method": "GET",
      "path": "/v1/evidence/counts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "by",
        "task",
        "session",
        "agent",
        "tool",
        "principal",
        "decision",
        "rule",
        "app",
        "since",
        "until",
        "outcomes"
      ],
      "summary": "Records you may see, counted by rule, tool, agent, app or decision (`by`), with the same filters as the list. outcomes=exclude (default) counts each decision once; include or only count the outcome records too"
    },
    {
      "operationId": "getPolicy",
      "method": "GET",
      "path": "/v1/policy",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "The policy in force: the deny rules in evaluation order (id, name, CEL expression, message, hint, bundle, `pack`), the tool registry with tiers, \"core\" and the loaded bundles (`packs`)"
    },
    {
      "operationId": "explainPolicy",
      "method": "GET",
      "path": "/v1/policy/explain",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "agent",
        "tool",
        "args"
      ],
      "summary": "Would this be allowed? A dry run of the real policy for an agent, a tool and its args (JSON) on a fresh session: the decision and each rule's verdict in order. Records nothing"
    },
    {
      "operationId": "listReceipts",
      "method": "GET",
      "path": "/v1/receipts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "repo",
        "pr"
      ],
      "summary": "PR receipts: what Clearance's agents opened on a repo (and PR), the commit, the paths"
    },
    {
      "operationId": "listProvenance",
      "method": "GET",
      "path": "/v1/provenance",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "repo",
        "pr"
      ],
      "summary": "The agent-gate verdicts recorded for a PR (provenance.verify)"
    },
    {
      "operationId": "listClearances",
      "method": "GET",
      "path": "/v1/clearances",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "app",
        "env",
        "state",
        "repo",
        "pr",
        "tier",
        "since",
        "limit",
        "after"
      ],
      "summary": "The deployment gate's changes, newest first: tier and why, state (holding, cleared, denied, expired, superseded), the requirement and the approvals so far, what the grant binds to. A person sees their apps' changes and the ones their groups may clear; the cursor is updated_at"
    },
    {
      "operationId": "countClearances",
      "method": "GET",
      "path": "/v1/clearances/counts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "app",
        "env",
        "state",
        "since",
        "by"
      ],
      "summary": "Changes counted by state, tier, app, env or cleared_by (the C1 stats: holding, cleared by policy and by people, denied)"
    },
    {
      "operationId": "getClearance",
      "method": "GET",
      "path": "/v1/clearances/{id}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "One change: the objects and paths it touches, every reason for its tier, the requirement, the approvals, the checks as last reported"
    },
    {
      "operationId": "getClearancePolicy",
      "method": "GET",
      "path": "/v1/clearance-policy",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "The deployment gate's baseline policy: the tier table, the people each tier needs, the outside groups, the TTL. A repo's clearance.yaml can only tighten it"
    },
    {
      "operationId": "listDefinitions",
      "method": "GET",
      "path": "/v1/definitions",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "full"
      ],
      "summary": "The agent definitions Clearance decides with: the bundled set and the cluster pins the core stored, each with its source; rejected pins with the reason. full=1 (auditors) adds instructions"
    },
    {
      "operationId": "getContract",
      "method": "GET",
      "path": "/v1/contract",
      "roles": [
        "any"
      ],
      "params": [],
      "summary": "This contract"
    }
  ],
  "responses": {
    "countClearances": {
