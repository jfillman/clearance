{
  "api": "clearance-api",
  "version": "v1",
  "notes": "GET only. Writes (POST /v1/human/requests/{id}/answer) go to the gateway.",
  "operations": [
    {
      "operationId": "listAgents",
      "method": "GET",
      "path": "/v1/agents",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "full"
      ],
      "summary": "Agent definitions: kind, identity, owner, tier ceiling, tools, scope, limits, triggers"
    },
    {
      "operationId": "getAgent",
      "method": "GET",
      "path": "/v1/agents/{name}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "full"
      ],
      "summary": "One agent definition"
    },
    {
      "operationId": "listSessions",
      "method": "GET",
      "path": "/v1/sessions",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "agent",
        "principal",
        "task",
        "state",
        "limit",
        "after"
      ],
      "summary": "Sessions you may see, newest first: limits, budget used, breaker, run, parent, expiry; state is live, closed or expired"
    },
    {
      "operationId": "getSession",
      "method": "GET",
      "path": "/v1/sessions/{id}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "One session"
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{task_id}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "A run tree: every session of the task, with parent links and totals"
    },
    {
      "operationId": "listEvidence",
      "method": "GET",
      "path": "/v1/evidence",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "task",
        "session",
        "agent",
        "tool",
        "principal",
        "decision",
        "rule",
        "app",
        "since",
        "until",
        "limit",
        "after"
      ],
      "summary": "Evidence records you may see, newest first; the cursor is seq"
    },
    {
      "operationId": "getEvidence",
      "method": "GET",
      "path": "/v1/evidence/{seq}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "One evidence record with its hash"
    },
    {
      "operationId": "verifyEvidence",
      "method": "GET",
      "path": "/v1/evidence/verify",
      "roles": [
        "auditor"
      ],
      "params": [],
      "summary": "The whole chain checked from genesis: ok, count, head, the first bad seq"
    },
    {
      "operationId": "countEvidence",
      "method": "GET",
      "path": "/v1/evidence/counts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "by",
        "decision",
        "agent",
        "tool",
        "app",
        "since",
        "until"
      ],
      "summary": "Records you may see, counted by rule, tool, agent, app or decision (`by`), with the same filters as the list"
    },
    {
      "operationId": "getPolicy",
      "method": "GET",
      "path": "/v1/policy",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "The policy in force: the deny rules in evaluation order (id, name, CEL expression, message, hint, pack), the tool registry with tiers, the packs"
    },
    {
      "operationId": "explainPolicy",
      "method": "GET",
      "path": "/v1/policy/explain",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "agent",
        "tool",
        "args"
      ],
      "summary": "Would this be allowed? A dry run of the real policy for an agent, a tool and its args (JSON) on a fresh session: the decision and each rule's verdict in order. Records nothing"
    },
    {
      "operationId": "listReceipts",
      "method": "GET",
      "path": "/v1/receipts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "repo",
        "pr"
      ],
      "summary": "PR receipts: what Clearance's agents opened on a repo (and PR), the commit, the paths"
    },
    {
      "operationId": "listProvenance",
      "method": "GET",
      "path": "/v1/provenance",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "repo",
        "pr"
      ],
      "summary": "The agent-gate verdicts recorded for a PR (provenance.verify)"
    },
    {
      "operationId": "listHumanRequests",
      "method": "GET",
      "path": "/v1/human/requests",
      "roles": [
        "person",
        "delegate",
        "notifier",
        "auditor"
      ],
      "params": [
        "since"
      ],
      "summary": "Pending human requests: a person's, those they may answer; a notifier's, every pending one (with owner and group), created since `since`"
    },
    {
      "operationId": "listEvents",
      "method": "GET",
      "path": "/v1/events",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "app",
        "agent",
        "source",
        "key",
        "subject",
        "since",
        "until",
        "limit",
        "after"
      ],
      "summary": "The events the trigger bridge received, newest first, each with what it did per agent (launched, deduped, braked, refused): the history a trigger dry run, an agent's trigger statistics and an app's run marks read. Kept 30 days; the cursor is received_at"
    },
    {
      "operationId": "listClearances",
      "method": "GET",
      "path": "/v1/clearances",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "app",
        "env",
        "state",
        "repo",
        "pr",
        "tier",
        "since",
        "limit",
        "after"
      ],
      "summary": "The deployment gate's changes (gate.py), newest first: tier and why, state (holding, cleared, denied, expired, superseded), the requirement and the approvals so far, what the grant binds to. A person sees their apps' changes and the ones their groups may clear; the cursor is updated_at"
    },
    {
      "operationId": "countClearances",
      "method": "GET",
      "path": "/v1/clearances/counts",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [
        "app",
        "env",
        "state",
        "since",
        "by"
      ],
      "summary": "Changes counted by state, tier, app, env or cleared_by (the C1 stats: holding, cleared by policy and by people, denied)"
    },
    {
      "operationId": "getClearance",
      "method": "GET",
      "path": "/v1/clearances/{id}",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "One change: the objects and paths it touches, every reason for its tier, the requirement, the approvals, the checks as last reported"
    },
    {
      "operationId": "getClearancePolicy",
      "method": "GET",
      "path": "/v1/clearance-policy",
      "roles": [
        "person",
        "delegate",
        "auditor"
      ],
      "params": [],
      "summary": "The deployment gate's baseline policy: the tier table, the people each tier needs, the outside groups, the TTL. A repo's clearance.yaml can only tighten it"
    },
    {
      "operationId": "getContract",
      "method": "GET",
      "path": "/v1/contract",
      "roles": [
        "any"
      ],
      "params": [],
      "summary": "This contract"
    }
  ]
}
